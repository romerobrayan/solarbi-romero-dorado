      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts_inicio AS \"Inicio\",\n       ts_fin AS \"Fin\",\n       dispositivo_id AS \"Dispositivo\",\n       rule_id AS \"Regla\",\n       severity AS \"Severidad\",\n       lecturas AS \"Lecturas\",\n       round(extract(epoch FROM ts_fin - ts_inicio) / 60) AS \"Minutos\"\nFROM dq.fault_event\nWHERE $__timeFilter(ts_inicio)\n  AND dispositivo_id IN ($dispositivo)\nORDER BY ts_inicio DESC",
          "refId": "A"
        }
      ],
      "title": "Eventos de falla (dq.fault_event)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "failed": {
                        "color": "red",
