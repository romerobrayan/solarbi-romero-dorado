          "rawSql": "SELECT ts_inicio AS \"time\",\n       ts_fin AS timeend,\n       rule_id || ' · ' || severity || ' · ' || lecturas || ' lecturas' AS text,\n       rule_id AS tags\nFROM dq.fault_event\nWHERE $__timeFilter(ts_inicio)\n  AND dispositivo_id IN ($dispositivo)",
