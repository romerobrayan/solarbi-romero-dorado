        ]
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 25
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Inicio\",\n       source_file AS \"Archivo\",\n       status AS \"Estado\",\n       bronze_status AS \"Bronze\",\n       filas_leidas AS \"Leídas\",\n       filas_validas AS \"Válidas\",\n       pct_validas AS \"% válidas\",\n       duracion_s AS \"Duración (s)\"\nFROM dq.etl_run_log\nORDER BY started_at DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Calidad: últimas corridas del ETL (dq.etl_run_log)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-postgres"
      },
      "description": "Suma de dq.rule_result de las corridas del rango que cargaron un archivo nuevo en Bronze (las repeticiones no se cuentan dos veces).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 25
      },
      "id": 5,
      "options": {
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xField": "Regla"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.rule_id || ' (' || r.action || ')' AS \"Regla\",\n       sum(r.filas_afectadas) AS \"Filas\"\nFROM dq.rule_result AS r\nJOIN dq.etl_run_log AS l USING (run_id)\nWHERE $__timeFilter(l.started_at)\n  AND l.bronze_status = 'loaded'\nGROUP BY r.rule_id, r.action\nORDER BY 2 DESC, 1",
          "refId": "A"
        }
      ],
      "title": "Calidad: filas afectadas por regla (corridas que cargaron datos)",
      "type": "barchart"
    }
  ],
