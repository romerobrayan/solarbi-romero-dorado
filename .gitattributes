# Normalize line endings in the repository; files mounted into Linux
# containers (shell, SQL, provisioning YAML) are always checked out with LF.
* text=auto

*.sh    text eol=lf
*.sql   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf

# Data files are stored byte for byte: Bronze is immutable and the ETL identifies a
# file by its SHA-256, which must be the same on every clone and in CI.
*.csv   -text

# Binary formats: never diff or normalize.
*.pbix  binary
*.abf   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
*.parquet binary
