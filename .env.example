# SolarBI Pascual - environment template.
# Copy to .env (never commit .env) and replace every "change-me" value:
#   Copy-Item .env.example .env
#
# Docker Compose interpolates "$" inside .env values: avoid "$" in passwords
# (letters, digits, "-" and "_" are safe).

# --- PostgreSQL + TimescaleDB (service "db") --------------------------------
# Host and port used by Python on your machine. Containers reach the
# database as db:5432 on the internal network, whatever POSTGRES_PORT is.
# 5433 avoids clashing with a native PostgreSQL (or another container) on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=solarbi
# Owner role: used only by the ETL and for administration.
POSTGRES_USER=solarbi_owner
POSTGRES_PASSWORD=change-me-owner

# Read-only login roles, created on the first start of an empty volume
# (sql/init/01_roles.sh). Changing them later requires ALTER ROLE (see README).
GRAFANA_READER_PASSWORD=change-me-grafana-reader
POWERBI_READER_PASSWORD=change-me-powerbi-reader

# ETL role (non-superuser, owns the tables). Created by migration 0001; its
# password is applied by "python scripts/migrate.py" (also after a change here).
ETL_WRITER_PASSWORD=change-me-etl-writer

# --- Grafana (service "grafana") ---------------------------------------------
GRAFANA_PORT=3000
# Applied only when Grafana creates its internal database (first start).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Recipient of the email contact point (provisioned to show production; it only
# sends once SMTP is configured). Not a secret.
ALERT_EMAIL_TO=operador@example.com

# --- Data paths for the ETL (optional, relative to the repo root) -------------
# Point BRONZE_DIR outside the repo for the large real dataset.
# DATA_DIR=data
# BRONZE_DIR=data/bronze
# SILVER_DIR=data/silver
# SAMPLES_DIR=data/samples
# CONTRACTS_DIR=contracts
